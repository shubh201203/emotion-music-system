# Backend Environment Variables (Copy to backend/.env)

# Spotify Web API Credentials (Developer Dashboard: https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# Spotify Redirect URI (Optional for Client Credentials, required for user auth flows)
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8000/callback

# MongoDB Connection URI (Optional - defaults to mongodb://localhost:27017/ if omitted)
# If omitted or unavailable, the system runs with graceful degradation (in-memory mock feedback)
MONGO_URI=mongodb://localhost:27017/
